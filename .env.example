# Required: shared secret appended to the webhook URL as ?token=
WEBHOOK_SECRET=

# Required: AITUNNEL API key from https://aitunnel.ru/ (Keys section)
AITUNNEL_API_KEY=

# Required for internet search; if omitted, regular model answers still work
SERPER_API_KEY=

# Optional; default is Gemini 3.5 Flash Lite through AITUNNEL
AITUNNEL_MODEL=gemini-3.5-flash-lite
